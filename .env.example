# ===== 路径 =====
# 手册根目录与索引位置。**留空即用包内布局**(<项目>/pdf、<项目>/index.lance),
# 交付包解压后通常无需填写。手册放在别处时才需要显式指定。
PDF_ROOT=
DB_PATH=

# ===== Embedding / Rerank 服务(OpenAI 兼容 /v1 接口) =====
# ⚠️ EMBED_MODEL 必须与索引构建时所用模型一致 —— 向量只在同一模型下才可比,
#    换了模型必须全量重建索引(uv run python -m backend.ingest --rebuild),
#    否则检索会静默变差而不是报错。交付包内的 MANIFEST.txt 记录了构建时所用模型
#    (仓库里没有该文件,它是 tools/build_release.py 打包时生成的)。
# ⚠️ 密钥不会随数据包提供,需自行填写;只从环境读取,不写入配置文件或数据包。
# ⚠️ 密钥需在服务商侧开通对应的模型范围:嵌入与重排都要能路由到,否则查询会降级。
EMBED_BASE_URL=https://api.siliconflow.cn/v1
# 必填,形如 sk-xxxxx。留空 = 向量检索降级为纯 FTS(不报错,只是效果变差)。
EMBED_API_KEY=
EMBED_MODEL=qwen3-embedding-8b
# 向量维度,必须与索引一致。建库与查询两侧都会显式发送这个值,不依赖服务商默认值
# (不同服务商对同一模型的默认维度可能不同;维度不符时向量通道会降级并记日志)。
# 0 = 不发送该参数,仅用于不支持 dimensions 的服务商。
EMBED_DIMENSIONS=768
RERANKER_MODEL=rerank-v4.0-pro

# ===== 索引并发参数 =====
EMBED_BATCH=32
EMBED_WORKERS=8
EXTRACT_WORKERS=4

# ===== OCR 服务(扫描页兜底,可选) =====
# OCR_BACKEND 选后端:
#   local  = 本机 PaddleOCR 服务(见 ocr_service.py,需独立环境,约 4.9GB)
#   remote = 远程视觉模型 API(OpenAI 兼容 /chat/completions,图片 base64 内联)
# 用 remote 时填下面三项;用 local 只需 OCR_URL。
OCR_BACKEND=local
OCR_URL=http://127.0.0.1:8900
OCR_API_BASE=
OCR_API_KEY=
OCR_MODEL=paddleocr-vl-1.6
# 提示词。默认 "OCR";paddleocr-vl 与 hunyuan-ocr 都用它最佳。
# 不要写自然语言排版要求(paddle 会幻觉);hunyuan 的 "doc_parse" 会改写原文,勿用于检索。
OCR_PROMPT=OCR

# ===== 管理接口令牌 =====
# POST /api/admin/restart 与 /api/admin/shutdown 需要 X-Admin-Token 头;
# 留空则这两个接口一律返回 403(即无法远程重启后端)。
# 生成方式:python -c "import secrets; print(secrets.token_hex(16))"
ADMIN_TOKEN=

# ===== 部署绑定(本地裸跑不用动;容器部署由 compose 注入,这里只作文档) =====
# BACKEND_HOST: 后端监听地址,127.0.0.1(默认,仅本机) / 0.0.0.0(容器、局域网)
# MCP_INPROC:  MCP 是否挂进后端进程(默认 1)。1 = 单进程,API 与 MCP 同端口 8100,
#              路径 MCP_PATH;省掉一个完整 Python 进程(约 650MiB)。
#              设 0 则后端不挂 MCP,需另起 server.py 进程(下面的 MCP_* 生效)。
# MCP_PATH:    内嵌模式下 MCP 的挂载路径(默认 /mcp)
# MCP_TRANSPORT / MCP_HOST / MCP_PORT: 独立 server.py 进程的传输方式(stdio/http)与监听
#BACKEND_HOST=127.0.0.1
#MCP_INPROC=1
#MCP_PATH=/mcp
#MCP_TRANSPORT=stdio
#MCP_HOST=0.0.0.0
#MCP_PORT=8101
